%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2ad786239b454ff089b602ab69c6618b, type: 3}
  m_Name: SceneCatalog
  m_EditorClassIdentifier: Shieldbreak.Data::Shieldbreak.Data.SceneCatalogDefinition
  briefingSeconds: 12
  entries:
  - id: duel
    title: "Duell"
    section: "Spielen"
    scene: M1_Duel
    launch: 1
    scenario: {fileID: 0}
    briefingOnStart: 0
    objective: "Held gegen 1 bis 3 Bots, mit den Einstellungen aus dem Hauptmenü (Kampfgefühl, Gegner-Stufe, Gegnerzahl, Waffen). Gewonnen, wenn alle Gegner fallen; danach kommt der Ergebnisbildschirm. Prüft das Kampfgefühl aus M1."
    controlMaps:
    - Combat
    - Duel
    checks:
    - "Leichter Angriff (tippen) und schwerer Hieb (halten) treffen spürbar: Hitstop, Kamera-Kick, Sound"
    - "Block halten fängt Hiebe von vorn ab; kurz vor dem Treffer gedrückt gibt einen Perfect Block (Gegner taumelt)"
    - "Finte (Q), Ausweichschritt (Leertaste), Sprung (C) und Sprint (Shift) tun, was sie sollen"
    - "Waffe wechseln (1 / 2): Zweihänder trifft härter, E macht den Sprung-Hieb, mit Schild den Schildstoß"
    - "F6, F7, F10: Kampfgefühl, Gegner-Stufe und Gegnerzahl wechseln sichtbar"
    - "Nach dem Kampf: Ergebnisbildschirm mit Nochmal, Anders einstellen, Hauptmenü"
  - id: tutorial
    title: "Tutorial"
    section: "Spielen"
    scene: M1_Duel
    launch: 2
    scenario: {fileID: 0}
    briefingOnStart: 0
    objective: "Geführtes Duell gegen einen geduldigen Gegner: 14 Schritte, jeder ist erledigt, sobald du ihn ausführst. Der Einstieg für neue Tester."
    controlMaps:
    - Combat
    - Tutorial
    checks:
    - "Alle 14 Schritte lassen sich durch Tun abschließen (F12 nur, wenn einer hängt)"
    - "Jeder Hinweis ist ohne weitere Erklärung verständlich"
    - "Am Ende steht \"Tutorial abgeschlossen\""
  - id: spectate
    title: "Zuschauen"
    section: "Spielen"
    scene: M1_Duel
    launch: 3
    scenario: {fileID: 0}
    briefingOnStart: 0
    objective: "Bot gegen Bot, die Kamera kreist. Zeigt, ob die Bots dieselben Regeln sauber spielen wie du."
    controlMaps:
    - Duel
    - Sim
    checks:
    - "Bots greifen an, blocken und finten sichtbar; keiner steht nur herum"
    - "F7 (Gegner-Stufe): eine höhere Stufe kämpft erkennbar besser"
    - "Z (Zeitlupe) macht Treffer und Blocks gut lesbar"
  - id: company
    title: "Kompanie"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 0}
    briefingOnStart: 1
    objective: "Du bist Held und Anführer zugleich: deine Linie (links) und dein Schildwall (rechts) gegen eine feindliche Linie und einen Keil unter einem Kommandanten, der angreift, flankiert oder hält, je nachdem, wie es steht. Befiehl schnell über das Radialmenü (F halten) oder mit Überblick aus der Kommandoansicht (V halten), und kämpfe selbst. Beide Seiten haben Bogenschützen. Ziel: Der Feind bricht und flieht, bevor deine Leute es tun. Fällst du, ist die Schlacht verloren. Danach zeigt ein Ergebnisbildschirm, was passiert ist."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "F halten, Maus nach oben, loslassen: beide Formationen rücken vor (Bestätigung oben im Bild)"
    - "F halten, Mausrad (Ziel: Formation 1), Maus nach links unten: nur Formation 1 bildet einen Schildwall"
    - "Folgen geben und mit dem Helden weglaufen: die Truppe kommt nach"
    - "Mitten im Kampf F halten: das Menü bleibt bedienbar, der Held schlägt währenddessen nicht; fühlt sich riskant, aber nicht lähmend an"
    - "Eine Seite bricht und flieht, bevor sie ausgelöscht ist; Fliehende verlassen das Feld"
    - "F ist gut erreichbar, die acht Richtungen sind gut zu merken"
    - "V halten: Die Kamera fährt in etwa einer halben Sekunde hoch, die Zeit läuft langsamer weiter; jede Formation ist umrandet und mit Typ, Befehl und Moral beschriftet"
    - "In der Kommandoansicht eine eigene Formation anklicken und rechts eine Frontlinie ziehen: Sie marschiert dorthin, so breit und so ausgerichtet wie gezogen"
    - "Rechtsklick auf eine feindliche Formation: Die Auswahl rückt gegen genau diese vor (rote Linie zum Ziel), nicht gegen die nächste"
    - "In der Kommandoansicht 4 drücken: Die Auswahl (ohne Auswahl: alle) bildet einen Kreis; 1 macht wieder eine Linie"
    - "Solange die Kommandoansicht offen ist, zieht sich der Held hinter die eigene Linie zurück und wehrt sich, wenn ihn jemand angreift"
    - "V loslassen: Die Kamera kommt zurück, die Steuerung ist sofort wieder da; Wechsel fühlt sich riskant, aber nicht lähmend an"
    - "Schlacht gewinnen: Kurz nachdem der Feind bricht, erscheint der Ergebnisbildschirm mit Sieg, Verlusten beider Seiten und deiner Statistik"
    - "Schlacht verlieren (Held stirbt oder die eigene Truppe bricht): Ergebnisbildschirm mit Gefallen bzw. Niederlage; Nochmal startet dieselbe Schlacht von vorn"
    - "Der Sieg fühlt sich verdient an: Du weißt, warum der Feind gebrochen ist"
    - "In der Kommandoansicht eine Formation hinter den Feind stellen: Unterwegs lässt sie sich nicht ablenken, am Ziel greift sie seinen Rücken von selbst an (Beschriftung: von selbst)"
    - "Mauszeiger auf eine feindliche Formation: Sie leuchtet auf, daneben steht Rechtsklick: angreifen"
    - "Mehrmals neu starten und verschieden aufstellen: Der Feind greift nicht immer gleich an, er flankiert auch; F3 zeigt seine Taktik und warum"
    - "Stell deine Truppe breit auf oder lass eine Seite offen: Der Feind nutzt das (F3: Feind offen links, rechts) und schickt eine Formation um dich herum"
    - "F3: Die Prognose passt zur Lage; stell dich dünner oder breiter auf und sie ändert sich, fallen Soldaten, sinkt sie"
    - "Nach einer Niederlage kannst du sagen, was du hättest anders machen müssen; der Feind hat nichts getan, was du nicht auch könntest"
    - "Beide Seiten haben Schützen: Pfeile fliegen sichtbar im Bogen über die eigenen Reihen, Schützen bleiben stehen und treffen die eigenen Leute nicht"
    - "Kommt der Feind nah an deine Schützen, fallen sie hinter die Infanterie zurück; steht er direkt vor ihnen, ziehen sie das Schwert (T holt sie ins Abschirmen zurück)"
    - "Lass eine Formation unter Beschuss halten: Sie dreht sich zu den Schützen, bildet den Schildwall (Beschriftung: unter Beschuss), die Pfeile prallen am Schild ab, und danach geht sie in ihre Form zurück"
    - "R in der Kommandoansicht: Die Haltung wechselt (Stellung halten, Reagieren, Aggressiv) und steht in der Beschriftung; mit Stellung halten bleibt die Formation stehen, auch wenn der Feind nahe ist"
  - id: battle
    title: "Schlacht: 50 gegen 50"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 11400000, guid: 6f75f8694b2840aea83a71d42ebde36b, type: 2}
    briefingOnStart: 1
    objective: "Fünf Formationen pro Seite: drei Linien, ein Keil in Reserve, Bogenschützen. Der Feind hat einen Kommandanten. Für den Feldherr-Test: V halten, L drücken und die Schlacht nur von oben führen; WASD verschiebt den Blick, dein Held kämpft solange allein."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "Feldherr-Test: Mit V und L oben bleiben und die Schlacht nur von dort führen. Ist das spannend?"
    - "Nach einer Niederlage: Du kannst sagen, wo du hättest stehen müssen; F3 zeigt, was der Feind vorhatte"
    - "WASD verschiebt den Blick, L hält die Ansicht offen, V bringt dich zurück in den Kampf"
    - "Das Bild bleibt flüssig, auch wenn alle kämpfen (F1 zeigt FPS und Sim-Zeit)"
    - "Alle Soldaten sind als Figuren zu sehen, keine als Kapseln"
  - id: battle-large
    title: "Schlacht: 100 gegen 100"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 11400000, guid: e9bed61bb826f60b81230c5a5330342d, type: 2}
    briefingOnStart: 1
    objective: "Sechs Formationen pro Seite auf einer Karte von 200 m: drei Linien, ein Keil in Reserve, zwei Gruppen Bogenschützen. Der Feind hat einen Kommandanten. Mit V und L führst du sie von oben, WASD verschiebt den Blick."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "Das Bild bleibt flüssig, auch wenn alle 200 kämpfen (F1 zeigt FPS und Sim-Zeit)"
    - "Die Karte ist groß genug für eine Flanke, und die Schlacht bleibt trotzdem nicht stehen"
    - "Alle Soldaten sind als Figuren zu sehen, keine als Kapseln"
  - id: battle-hill
    title: "Schlacht am Hügel"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 11400000, guid: 0f97f6dee0cf31e5bc9a31044da24702, type: 2}
    briefingOnStart: 1
    objective: "100 gegen 100 um zwei Hügel: Der große liegt links zwischen den Heeren, der kleine rechts näher am Feind. Bergauf läuft man langsamer, von oben trifft man härter und schießt weiter. Wer den großen Hügel hält, hat den Vorteil."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "Die Soldaten stehen auf dem Boden, keiner schwebt oder versinkt, auch beim Marsch über den Hügel"
    - "Eine Formation am Hang wird sichtbar langsamer, bergab schneller"
    - "In der Kommandoansicht landet ein Befehl dort, wo der Zeiger auf dem Hügel steht"
    - "Die Kampfkamera taucht am Hang nicht in den Boden ein"
    - "Der Hügel lohnt sich: Wer oben steht, gewinnt spürbar leichter"
  - id: battle-forest
    title: "Schlacht am Wald"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 11400000, guid: 29e7bf79240eaa0fef4303b7ccb1f084, type: 2}
    briefingOnStart: 1
    objective: "100 gegen 100 zwischen Wald und Sumpf: Links ein Wald, rechts ein Sumpf, dazwischen freies Feld. Im Wald läuft man langsamer, die Reihen lösen sich auf, und Bäume fangen Pfeile ab. Der Sumpf bremst noch stärker und deckt nicht."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "Eine Formation im Wald verliert sichtbar ihre Reihen und läuft langsamer, draußen ordnet sie sich wieder"
    - "Formationen laufen von selbst um den Sumpf herum, wenn der Umweg lohnt"
    - "Schützen sind im Wald deutlich schlechter zu treffen als auf freiem Feld"
    - "Bäume stehen nicht so dicht, dass man Soldaten aus der Kommandoansicht nicht mehr erkennt"
    - "Das Bild bleibt flüssig, auch im Wald"
  - id: battle-cavalry
    title: "Schlacht mit Reiterei"
    section: "Spielen"
    scene: M2_Company
    launch: 0
    scenario: {fileID: 11400000, guid: edfcaac98ce6a77136b428315a17cd7e, type: 2}
    briefingOnStart: 1
    objective: "100 gegen 100, jede Seite mit 12 Reitern auf der Flanke. Beide Reitereien greifen sofort an, die feindliche von links, deine von rechts; mit dem Radialmenü (Halten) hältst du deine zurück. Reiter kommen nur langsam in Fahrt, senken die Lanze und reiten durch die Reihen. Ein gestemmter Speer oder ein Schildwall hält sie auf, eine Linie nicht."
    controlMaps:
    - Radial
    - CommandView
    - Combat
    - CommanderDebug
    checks:
    - "Die Pferde kommen erst langsam in Fahrt und reiten im Bogen, sie drehen nicht auf der Stelle"
    - "Ein Reiter senkt kurz vor dem Gegner die Lanze, und ein Treffer im Galopp wirft den Mann um"
    - "Wo ein Pferd in eine Linie reitet, fliegen Soldaten zur Seite, und das Pferd wird langsamer"
    - "Gegen Speere oder einen Schildwall bleiben die Reiter stecken, die Speere werfen sie aus dem Sattel"
    - "Nach einem Durchgang reiten die Reiter weiter, wenden und greifen wieder an"
    - "Die Pferde sind klar als Pferde zu erkennen, auch aus der Kommandoansicht (Platzhalter bis zu den Modellen)"
  - id: sandbox
    title: "Sandbox: Formationen und Moral"
    section: "Werkzeuge"
    scene: M0_Sandbox
    launch: 0
    scenario: {fileID: 0}
    briefingOnStart: 1
    objective: "Draufsicht ohne Helden: vier Formationen zu je 10 Soldaten, rot gegen blau. Du befiehlst beide Seiten und siehst Slots, Wege und Moral im Overlay. Hier prüfst du Formationen, Kampf in Formation und Moral, ohne selbst zu kämpfen."
    controlMaps:
    - DebugOrders
    - DebugOverlay
    - DebugCamera
    - Sim
    checks:
    - "Formation anklicken, rechts klicken: marschiert als Block, die Linie bleibt Linie"
    - "Linie hinter die Truppe ziehen (rechte Maustaste ziehen): dreht um, das hintere Glied wird Front"
    - "Beide roten Formationen wählen und eine lange Linie ziehen: teilen sich die Linie, niemand kreuzt"
    - "4 bis 8 durchschalten: die Formation formt auf der Stelle um"
    - "Durch das Tor in der Mauer schicken: Weg im Overlay (F), alle kommen durch; eine breite Linie hinter den Fels läuft außen herum"
    - "1 und R, dann 2 und C: die Linien treffen sich, das zweite Glied rückt nach, Blau stürmt frei"
    - "Mitten im Kampf X: die Formation dreht ab, kämpft nicht und steht 20 m weiter mit Front zum Feind"
    - "M (Moral): Flecken, wo Soldaten fallen; eine Seite bricht vor der Auslöschung, Fliehende (oranger Ring) verschwinden am Rand"
    - "Formation mit H festsetzen und eine feindliche Formation in ihre Flanke oder ihren Rücken schicken: Sie bleibt stehen, dreht die Front zum Feind und die Beschriftung nennt kurz die Seite (Feind links, rechts, im Rücken)"
    - "Läuft flüssig (F1 zeigt FPS und Sim-Zeit)"
  - id: stress
    title: "Stresstest: 250 gegen 250"
    section: "Werkzeuge"
    scene: M0_Sandbox
    launch: 0
    scenario: {fileID: 11400000, guid: 578c37f82960f7548ae3c92fa71b9c8e, type: 2}
    briefingOnStart: 1
    objective: "Leistungstest aus M0 in der Sandbox-Szene: 500 lose Soldaten ohne Kampf und ohne Formationen. Ziel: die Sim braucht auch dann unter 2 ms pro Tick, wenn alle gleichzeitig marschieren."
    controlMaps:
    - DebugOrders
    - DebugCamera
    - DebugOverlay
    - Sim
    checks:
    - "3 (alle) und rechts klicken: alle 500 marschieren und stellen sich in Reihen auf, ohne sich zu durchdringen"
    - "Beide Blöcke durcheinander schicken (1, rechts klicken, 2, rechts klicken): sie weichen sich aus und kommen an"
    - "F1: Sim-Zeit pro Tick bleibt unter 2 ms, das Bild bleibt flüssig"
  - id: proto-animation
    title: "Prototyp: Oben-Hieb"
    section: "Werkzeuge"
    scene: Proto_Animation
    launch: 0
    scenario: {fileID: 0}
    briefingOnStart: 1
    objective: "Animations-Prototyp aus M0: ein Hieb von oben aus vier Key-Posen mit IK; die Klingenbahn ist nach Phase eingefärbt, unten läuft eine Zeitleiste. Offene Frage an Tarik: Ist der prozedurale Hieb lesbar und nicht steril?"
    controlMaps:
    - ProtoAttack
    - ProtoCamera
    checks:
    - "Leertaste spielt den Hieb ab; Ausholen, Treffen und Erholen sind unterscheidbar"
    - "N geht tickweise weiter; die Zeitleiste zeigt Phasen und Key-Posen"
    - "Ansicht 3 (Gegner-Sicht, 15 m): der Hieb ist als Hieb von oben erkennbar"
    - "Urteil: prozeduraler Hieb reicht, oder Fallback auf gekaufte Clips"
  - id: proto-style
    title: "Prototyp: Look und Kameras"
    section: "Werkzeuge"
    scene: Proto_Style
    launch: 0
    scenario: {fileID: 0}
    briefingOnStart: 1
    objective: "Look-Probe mit Figuren aus der Asset-Pipeline: zwei kleine Formationen in den Abständen, in denen das Spiel funktionieren muss (Nahkampf 4 m, Kampf 15 m, Lesbarkeit 40 m, Kommandoansicht)."
    controlMaps:
    - ProtoCamera
    checks:
    - "Ansichten 1 bis 5 durchschalten: die Teams sind in jeder Ansicht klar unterscheidbar, auch aus 40 m"
    - "O (Orbit): kein Flackern, Schatten und Kanten bleiben ruhig"
